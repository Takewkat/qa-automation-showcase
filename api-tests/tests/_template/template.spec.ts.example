import { expect, test } from "@api/fixtures";
import { completeOffer } from "@api/payloads";

/** One row, one test; the table sits next to the tests that read it. */
const ROWS = [
  { title: "a".repeat(200), expect: 201 },
  { title: "a".repeat(201), expect: 422 },
] as const;

test("XXX-000 creates a complete offer and reads it back", async ({ api, offers }) => {
  const created = await offers.create();
  const fetched = await api.getJobOffer(created.id);
  expect(fetched.title).toBe(created.title);
});

for (const row of ROWS) {
  test(`XXX-001 a title of ${row.title.length} chars is ${row.expect}`, async ({ api }) => {
    await api.createJobOffer(completeOffer({ title: row.title }), { expect: row.expect });
  });
}
