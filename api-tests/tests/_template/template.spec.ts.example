import { CreateJobOffer, GetJobOffer } from "@job-offer/api";
import { expect, test } from "@job-offer/fixtures/fixtures";
import { completeOffer } from "@job-offer/test-data/job-offers";

/** One row, one test; the table sits next to the tests that read it. */
const ROWS = [
  { name: "a blank title", title: "" },
  { name: "a 201-char title", title: "a".repeat(201) },
];

/** Tags: the folder, one layer (@happy-path, @validation-error, @error-case), the priority of the docs row. */
test(
  "XXX-000 creates a complete offer and reads it back",
  { tag: ["@offers", "@happy-path", "@p1"] },
  async ({ company, offers }) => {
    const created = await offers.create();
    const fetched = await new GetJobOffer(company).get(created.id);
    expect(fetched.title).toBe(created.title);
  },
);

for (const row of ROWS) {
  test(
    `XXX-001 ${row.name} is refused`,
    { tag: ["@offers", "@validation-error", "@p2"] },
    async ({ company }) => {
      await new CreateJobOffer(company).create(completeOffer({ title: row.title }), 422);
    },
  );
}
