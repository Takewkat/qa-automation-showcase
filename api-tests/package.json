{
  "name": "api-tests",
  "version": "0.0.0",
  "private": true,
  "description": "Job Offer Microservice API tests: Playwright request, OpenAPI contract checks, reference stub on node:http",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:ui": "playwright test --ui",
    "stub": "node stub/server.ts",
    "gen:types": "openapi-typescript spec/job-offer-swagger.yml -o src/generated/schema.d.ts",
    "report": "playwright show-report ../reports/api/html"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0"
  }
}
