{
  "name": "api-tests",
  "version": "0.0.0",
  "private": true,
  "description": "Job Offer Microservice API tests: Playwright request, OpenAPI contract checks, Hono reference stub",
  "scripts": {
    "test": "playwright test --pass-with-no-tests",
    "test:smoke": "playwright test --grep @smoke",
    "stub": "tsx stub/server.ts",
    "gen:types": "openapi-typescript spec/job-offer-swagger.yml -o src/generated/schema.d.ts",
    "report": "playwright show-report"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@hono/node-server": "2.1.6",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "hono": "4.13.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0"
  }
}
