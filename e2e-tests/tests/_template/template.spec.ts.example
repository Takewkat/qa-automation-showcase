import { test } from "@e2e/fixtures/test";
import { articleDraft } from "@e2e/test-data/factories";

/** A spec reads as the user story: fixtures bring the pages, factories bring unique data. Tags: the folder, then one layer. */
test(
  "XXX-000 publishes an item and sees it listed",
  { tag: ["@articles", "@happy-path"] },
  async ({ authenticatedPage, templatePage, track }) => {
    const draft = articleDraft();
    await templatePage.open();
    await templatePage.publish(draft.title);
    track(draft.title);
    await templatePage.assertItemVisible(draft.title);
  },
);
