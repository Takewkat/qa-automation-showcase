{
  "name": "e2e-tests",
  "version": "0.0.0",
  "private": true,
  "description": "Conduit RealWorld E2E flows: Playwright, page objects, API-seeded data",
  "scripts": {
    "test": "playwright test --pass-with-no-tests",
    "test:smoke": "playwright test --grep @smoke",
    "test:p1": "playwright test --grep @p1",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report ../reports/e2e/html"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0"
  }
}
