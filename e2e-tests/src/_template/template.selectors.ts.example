/** Selectors of one page: a group per component, camelCase keys, functions for dynamic ones. */
export const TEMPLATE_SELECTORS = {
  PATHS: { home: "/", item: (slug: string) => `/item/${slug}` },
  FORM: { title: 'input[name="title"]', submit: 'button:has-text("Publish")' },
  LIST: {
    items: ".item-preview",
    itemByTitle: (title: string) => `.item-preview:has(h1:text-is("${title}"))`,
  },
} as const;
