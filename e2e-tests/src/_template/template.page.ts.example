import { expect, test, type Page } from "@playwright/test";

import { BasePage } from "@e2e/pages/base.page";
import { TEMPLATE_SELECTORS as S } from "@e2e/selectors/template.selectors";

/** One class per page; every method is one this.step, named and logged, assertions start with assert. */
export class TemplatePage extends BasePage {
  constructor(page: Page) {
    super(page);
  }

  async open() {
    await this.goto(S.PATHS.home);
  }

  async publish(title: string) {
    await this.step(`Publish "${title}"`, async () => {
      await S.FORM.title(this.page).fill(title);
      await S.FORM.submit(this.page).click();
    });
  }

  async assertItemVisible(title: string) {
    await this.step(`Assert item "${title}" is listed`, async () => {
      await expect(S.LIST.itemByTitle(this.page, title)).toBeVisible();
    });
  }
}
