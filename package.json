{
  "name": "qa-automation-showcase",
  "version": "0.0.0",
  "private": true,
  "description": "API test suite for a job-offer microservice and Playwright E2E flows on Conduit RealWorld, built agent-ready",
  "license": "MIT",
  "engines": {
    "node": ">=22.22"
  },
  "workspaces": [
    "api-tests",
    "e2e-tests"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "test:api": "npm test --workspace api-tests",
    "test:e2e": "npm test --workspace e2e-tests",
    "traceability": "tsx scripts/check-traceability.ts",
    "verify": "bash scripts/verify.sh"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-playwright": "2.12.2",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
