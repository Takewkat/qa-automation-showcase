{
  "name": "qa-automation-showcase",
  "version": "0.0.0",
  "private": true,
  "description": "API test suite for a job-offer microservice and Playwright E2E flows on Conduit RealWorld, built agent-ready",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "api-tests",
    "api-tests/stub",
    "e2e-tests"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "test:api": "npm test --prefix api-tests",
    "test:api:local": "npm run test:local:run --prefix api-tests",
    "test:api:staging": "npm run test:staging:run --prefix api-tests",
    "test:e2e": "npm test --prefix e2e-tests",
    "test:e2e:demo": "npm run test:demo:run --prefix e2e-tests",
    "test:e2e:local": "npm run test:local:run --prefix e2e-tests",
    "conduit:local": "docker compose -f e2e-tests/local/compose.yml up --build",
    "conduit:local:down": "docker compose -f e2e-tests/local/compose.yml down",
    "traceability": "node scripts/check-traceability.mts",
    "report:scenarios": "node scripts/scenario-report.mts",
    "report:api": "playwright show-report reports/api/html",
    "report:e2e": "playwright show-report reports/e2e/html",
    "verify": "bash scripts/verify.sh"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-playwright": "2.12.2",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
